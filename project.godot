; Engine configuration file.
; MSLA (LCD) resin 3D printer simulator - workshop teaching tool.

config_version=5

[application]

config/name="Resin Printer Simulator"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1720
window/size/viewport_height=980
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

environment/defaults/default_clear_color=Color(0.05, 0.06, 0.08, 1)
anti_aliasing/quality/msaa_3d=2
